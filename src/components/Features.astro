---
import { brandConfig } from '../data/config';
const { features } = brandConfig;

// Mapping feature IDs to premium SVG icon paths
const iconMap: Record<string, string> = {
  'cold-pressed': 'M19 14l-7 7m0 0l-7-7m7 7V3', // Down Arrow / Pressing motion
  'organic': 'M12 3a9 9 0 00-9 9c0 1.5.3 3 .8 4.4L3 21l4.6-.8A9 9 0 1012 3z', // Speech/Leaf shape
  'no-added-sugar': 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' // Shield / Check badge
};
---

<section id="features" class="py-24 relative overflow-hidden bg-gradient-to-b from-slate-100 to-slate-200 dark:from-[#0b0f19] dark:to-[#0d1321]">
  <!-- Decorative Background Glow -->
  <div class="absolute left-[-10%] top-[30%] w-[400px] h-[400px] rounded-full bg-emerald-500/5 blur-[120px] pointer-events-none"></div>
  <div class="absolute right-[-10%] bottom-[10%] w-[400px] h-[400px] rounded-full bg-orange-500/5 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <span class="text-xs font-bold tracking-widest text-amber-400 uppercase bg-amber-400/10 px-4 py-1.5 rounded-full">
        The Panda Standard
      </span>
      <h2 class="text-4xl md:text-5xl font-black mt-6 mb-6 leading-tight text-slate-900 dark:text-white font-display">
        Why Cold-Pressed <br class="hidden sm:inline"/>
        Means Pure Perfection
      </h2>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        We never heat-pasteurize, never add water, and never compromise. Our raw process ensures every bottle is overflowing with maximum cellular nutrition.
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map((feat, idx) => (
        <div 
          class="group relative glass rounded-3xl p-8 hover:bg-white/85 dark:hover:bg-white/10 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between overflow-hidden reveal-on-scroll"
          style={{ transitionDelay: `${idx * 150}ms` }}
        >
          <!-- Hover Ambient Glow -->
          <div class="absolute -right-16 -top-16 w-32 h-32 rounded-full bg-slate-200/50 dark:bg-white/5 group-hover:bg-amber-400/10 blur-2xl transition-all duration-700"></div>

          <div>
            <!-- Icon Container -->
            <div class="h-14 w-14 rounded-2xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 flex items-center justify-center mb-8 text-amber-400 group-hover:scale-110 group-hover:bg-amber-400 group-hover:text-slate-950 transition-all duration-500">
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke-width="1.8" 
                stroke="currentColor" 
                class="w-6 h-6"
              >
                <path 
                  stroke-linecap="round" 
                  stroke-linejoin="round" 
                  d={iconMap[feat.id] || "M13 10V3L4 14h7v7l9-11h-7z"} 
                />
              </svg>
            </div>

            <!-- Content -->
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
              {feat.title}
            </h3>
            
            <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed mb-6">
              {feat.description}
            </p>
          </div>

          <!-- Bottom Accent Bar -->
          <div class="w-12 h-1 bg-slate-200 dark:bg-white/20 group-hover:bg-amber-400 group-hover:w-full transition-all duration-500 rounded-full"></div>
        </div>
      ))}
    </div>

    <!-- Live Counter / Comparison Section -->
    <div class="mt-20 glass dark:glass-dark rounded-3xl p-8 md:p-12 border border-slate-200 dark:border-white/5 relative overflow-hidden reveal-on-scroll">
      <!-- Glow -->
      <div class="absolute -left-1/4 top-0 w-[50%] h-[100%] rounded-full bg-gradient-to-r from-amber-400/10 to-transparent blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center relative z-10">
        <div>
          <h4 class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white mb-4">
            Traditional vs. Panda Cold-Pressed
          </h4>
          <p class="text-slate-600 dark:text-slate-300 text-sm md:text-base leading-relaxed mb-6">
            Standard store-bought juices are boiled at 160°F+ (Flash Pasteurization) to preserve shelf life, killing essential gut-friendly enzymes and vitamins. Panda Juices are extracted pneumatically and high-pressure raw certified, keeping every active ingredient alive.
          </p>
          <div class="flex items-center gap-4">
            <span class="text-3xl">🍊</span>
            <div>
              <p class="text-sm font-bold text-slate-900 dark:text-white">Always Raw, Never Heated</p>
              <p class="text-xs text-slate-500 dark:text-slate-400">Kept refrigerated at 38°F from farm to cap.</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/5 rounded-2xl p-6 text-center">
            <span class="text-3xl font-black text-amber-600 dark:text-amber-400 dark:text-glow-orange">5x</span>
            <p class="text-sm font-bold text-slate-900 dark:text-white mt-2">More Nutrients</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Compared to centrifugal juicers.</p>
          </div>
          <div class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-white/5 rounded-2xl p-6 text-center">
            <span class="text-3xl font-black text-emerald-600 dark:text-emerald-400 dark:text-glow-green">100%</span>
            <p class="text-sm font-bold text-slate-900 dark:text-white mt-2">Bioavailable</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Easy absorption by cells.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
