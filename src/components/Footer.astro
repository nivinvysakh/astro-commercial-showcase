---
import { brandConfig } from '../data/config';
const { footer, logo, tagline, contactEmail } = brandConfig;
---

<footer class="relative bg-slate-100 dark:bg-[#080c14] border-t border-slate-200 dark:border-white/5 pt-20 pb-12 overflow-hidden">
  <!-- Glowing Ambient Accents -->
  <div class="absolute right-0 bottom-0 w-[300px] h-[300px] rounded-full bg-amber-500/5 blur-[100px] pointer-events-none"></div>
  <div class="absolute left-0 top-1/2 w-[300px] h-[300px] rounded-full bg-emerald-500/5 blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10">
    
    <!-- Top Grid: Newsletter & Quick Links -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 pb-16 border-b border-slate-200 dark:border-white/5">
      
      <!-- Column 1: Brand details & Newsletter -->
      <div class="lg:col-span-5 space-y-6">
        <a href="/" class="inline-block text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          <span class="text-glow-orange">{logo}</span>
        </a>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed max-w-sm">
          {tagline}. Cold-pressed premium juices crafted in the wild, bottled for your cellular vitality.
        </p>

        <!-- Newsletter Subscription Form -->
        <div class="space-y-3 pt-2 max-w-md">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Join the Wild Pack Newsletter</p>
          <form id="newsletter-form" class="relative flex items-center bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 rounded-xl p-1 focus-within:border-amber-500 dark:focus-within:border-amber-400/50 transition-colors">
            <input 
              type="email" 
              placeholder="Enter your email" 
              required
              class="w-full bg-transparent text-sm text-slate-900 dark:text-white px-4 py-2.5 focus:outline-none placeholder-slate-400 dark:placeholder-slate-500"
            />
            <button 
              type="submit" 
              class="px-5 py-2.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-xs rounded-lg hover:bg-slate-800 dark:hover:bg-slate-200 transition-colors cursor-pointer"
            >
              Subscribe
            </button>
          </form>
          <!-- Success message -->
          <div id="newsletter-success" class="hidden text-emerald-600 dark:text-emerald-400 text-xs font-semibold items-center gap-1.5">
            <span>✓</span> Welcome to the Pack! Check your inbox for a wild discount.
          </div>
        </div>
      </div>

      <!-- Column 2, 3, 4: Dynamic Links -->
      <div class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8">
        <div>
          <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-6">Shop</h4>
          <ul class="space-y-4">
            {footer.links.shop.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        
        <div>
          <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-6">Company</h4>
          <ul class="space-y-4">
            {footer.links.company.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="col-span-2 md:col-span-1">
          <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-6">Legal</h4>
          <ul class="space-y-4">
            {footer.links.legal.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>

    <!-- Bottom Section: Contact info, Socials, Copyright -->
    <div class="pt-12 flex flex-col md:flex-row justify-between items-center gap-8">
      
      <!-- Contact Info -->
      <div class="text-center md:text-left space-y-1">
        <p class="text-sm font-medium text-slate-600 dark:text-slate-300">{footer.address.street}</p>
        <p class="text-xs text-slate-500">{footer.address.city} • {footer.address.phone}</p>
        <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
          ✉ <a href={`mailto:${contactEmail}`} class="hover:text-slate-900 dark:hover:text-white transition-colors">{contactEmail}</a>
        </p>
      </div>

      <!-- Social Icons -->
      <div class="flex items-center gap-4">
        <!-- Instagram -->
        <a href="https://instagram.com/pandajuices" target="_blank" rel="noopener noreferrer" class="h-10 w-10 rounded-xl glass flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-black dark:hover:text-white hover:scale-105 transition-all" aria-label="Instagram">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h.01"></path>
          </svg>
        </a>
        <!-- Facebook -->
        <a href="https://facebook.com/pandajuices" target="_blank" rel="noopener noreferrer" class="h-10 w-10 rounded-xl glass flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-black dark:hover:text-white hover:scale-105 transition-all" aria-label="Facebook">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
        <!-- Twitter -->
        <a href="https://twitter.com/pandajuices" target="_blank" rel="noopener noreferrer" class="h-10 w-10 rounded-xl glass flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-black dark:hover:text-white hover:scale-105 transition-all" aria-label="Twitter">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
          </svg>
        </a>
      </div>

    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-white/5 text-center text-slate-500 text-xs">
      <p>© {new Date().getFullYear()} Panda Premium Juices. All rights reserved. Sourced wild, pressed clean.</p>
    </div>

  </div>
</footer>

<script>
  const form = document.getElementById('newsletter-form');
  const successMsg = document.getElementById('newsletter-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Hide form inputs and show success message
    if (form) form.classList.add('hidden');
    if (successMsg) {
      successMsg.classList.remove('hidden');
      successMsg.classList.add('flex');
    }
  });
</script>
