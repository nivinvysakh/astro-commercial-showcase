---
import { brandConfig } from '../data/config';
const { process } = brandConfig;
---

<section id="process" class="py-24 relative overflow-hidden bg-gradient-to-b from-slate-200 to-slate-100 dark:from-[#0d1321] dark:to-[#0b0f19]">
  <!-- Background Accents -->
  <div class="absolute right-[5%] top-[10%] w-[500px] h-[500px] rounded-full bg-amber-500/5 blur-[150px] pointer-events-none"></div>
  <div class="absolute left-[5%] bottom-[15%] w-[400px] h-[400px] rounded-full bg-emerald-500/5 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <span class="text-xs font-bold tracking-widest text-emerald-400 uppercase bg-emerald-400/10 px-4 py-1.5 rounded-full">
        Our Craftsmanship
      </span>
      <h2 class="text-4xl md:text-5xl font-black mt-6 mb-6 leading-tight text-slate-900 dark:text-white font-display">
        The Farm-to-Bottle Journey
      </h2>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        We handle every ingredient with absolute care, using raw-certified safety processing and zero heating. Here is exactly how we bottle the wild.
      </p>
    </div>

    <!-- Timeline Layout -->
    <div class="relative max-w-5xl mx-auto">
      
      <!-- Central vertical timeline rail line (Desktop only) -->
      <div class="absolute left-1/2 transform -translate-x-1/2 top-0 bottom-0 w-px bg-purple-500/30 dark:bg-white/10 hidden md:block"></div>

      <div class="space-y-16 md:space-y-24 relative">
        {process.map((step, idx) => {
          const isEven = idx % 2 === 0;
          return (
            <div class="relative flex flex-col md:flex-row items-center justify-between">
              
              <!-- Left side content (or space) -->
              <div class={`w-full md:w-[45%] flex ${isEven ? 'justify-end md:text-right' : 'order-1 md:order-2 justify-start md:text-left'} reveal-on-scroll`}>
                <div class="group relative glass rounded-3xl p-8 hover:bg-white/85 dark:hover:bg-white/10 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-500 hover:-translate-y-1 w-full overflow-hidden">
                  <!-- Glow effect on hover -->
                  <div class="absolute -left-12 -top-12 w-24 h-24 rounded-full bg-emerald-500/5 group-hover:bg-emerald-500/10 blur-xl transition-all duration-500"></div>

                  <div class="relative z-10">
                    <span class="text-xxs uppercase tracking-widest font-extrabold text-emerald-400 bg-emerald-400/10 px-3 py-1 rounded-md mb-4 inline-block">
                      Step {step.step}
                    </span>
                    <h3 class="text-2xl font-bold text-slate-900 dark:text-white mt-2 mb-3 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                      {step.title}
                    </h3>
                    <p class="text-slate-600 dark:text-slate-300 text-sm md:text-base leading-relaxed mb-4">
                      {step.description}
                    </p>
                    
                    <!-- Expanding details panel on hover -->
                    <div class="pt-4 border-t border-slate-200 dark:border-white/5 opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                      <p class="text-xs text-slate-500 dark:text-slate-400 italic">
                        💡 {step.details}
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Central badge node -->
              <div class="absolute left-1/2 transform -translate-x-1/2 w-12 h-12 rounded-full border-4 border-slate-100 dark:border-[#0b0f19] bg-purple-600 dark:bg-slate-900 flex items-center justify-center text-white font-black z-20 shadow-lg shadow-purple-500/10 dark:shadow-black/50 hidden md:flex hover:scale-110 hover:bg-purple-700 dark:hover:bg-emerald-400 dark:hover:text-slate-950 transition-all duration-300 cursor-pointer">
                {step.step}
              </div>

              <!-- Right side content (or space) -->
              <div class={`w-full md:w-[45%] ${isEven ? 'order-1 md:order-2' : ''} hidden md:block`}>
                <!-- Empty spacer block to maintain symmetry -->
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>
