---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="404 - Page Not Found">
  <Navbar />

  <main
    class="pt-32 md:pt-40 pb-20 min-h-[85vh] flex flex-col justify-center items-center relative overflow-hidden bg-gradient-to-b from-slate-100 to-slate-50 dark:from-[#0b0f19] dark:to-[#0a0d14] px-4"
  >
    <!-- Glowing background accents -->
    <div
      class="absolute left-[-10%] top-[20%] w-[500px] h-[500px] rounded-full bg-amber-500/5 blur-[140px] pointer-events-none"
    >
    </div>
    <div
      class="absolute right-[-10%] bottom-[20%] w-[500px] h-[500px] rounded-full bg-pink-500/5 blur-[140px] pointer-events-none"
    >
    </div>

    <div
      class="max-w-xl w-full text-center relative z-10 space-y-8 reveal-on-scroll glass dark:glass-dark border border-slate-200 dark:border-white/10 rounded-[2.5rem] p-10 md:p-16 shadow-xl shadow-slate-200/50 dark:shadow-[0_30px_60px_rgba(0,0,0,0.6)]"
    >
      <!-- 404 Illustration / Symbol -->
      <div class="relative inline-flex items-center justify-center">
        <div
          class="absolute inset-0 rounded-full bg-amber-500/10 blur-xl animate-pulse"
        >
        </div>
        <span
          class="block text-9xl md:text-[11rem] font-black text-amber-500 font-sans tracking-tighter leading-none"
          >404</span
        >
      </div>

      <!-- Headline and Copy -->
      <div class="space-y-4">
        <h1
          class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white font-display"
        >
          Lost in the Wild?
        </h1>
        <p
          class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed max-w-sm mx-auto"
        >
          The blend or page you are looking for has wandered deep into the
          bamboo forest. Let's get you back to safety.
        </p>
      </div>

      <!-- Call to Action -->
      <div class="pt-4">
        <a
          href="/"
          class="inline-block px-8 py-4 text-sm font-bold text-white bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 rounded-2xl shadow-lg shadow-orange-500/20 transition-all duration-300 transform hover:-translate-y-0.5"
        >
          Return to Safety
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Local animations and reveal states */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
